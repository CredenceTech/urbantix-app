{
  "expo": {
    "name": "UrbanTixs",
    "slug": "urbantix-app",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "urbantixapp",
    "splash": {
      "image": "./assets/splash_screen_large.png",
      "resizeMode": "cover",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.urbantixs",
      "version": "1.09",
      "buildNumber": "1",
      "googleServicesFile": "./GoogleService-Info.plist",
      "appleTeamId": "TV7TL5MRV9",
      "infoPlist": {
        "NSCameraUsageDescription": "UrbanTixs uses the camera to scan QR codes on your event tickets for fast check-in at venues. No photos are stored or shared."
      },
      "splash": {
        "image": "./assets/splash_screen_large.png",
        "resizeMode": "cover",
        "backgroundColor": "#000000"
      }
    },
    "android": {
      "versionCode": 23,
      "version": "23",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.urbantixs",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "VIBRATE"
      ],
      "splash": {
        "image": "./assets/splash_screen_large.png",
        "resizeMode": "cover",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-asset",
      [
        "@react-native-google-signin/google-signin"
      ],
      "./plugins/withFullScreenBootsplash.js",
      "./plugins/withUrbantixsKeystore.js",
      "expo-build-properties",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "UrbanTixs uses the camera to scan QR codes on your event tickets for fast check-in at venues. No photos are stored or shared.",
          "enableMicrophonePermission": false,
          "enableCodeScanner": true
        }
      ]
    ]
  }
}
